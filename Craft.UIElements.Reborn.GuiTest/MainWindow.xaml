<Window x:Class="Craft.UIElements.Reborn.GuiTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Craft.UIElements.Reborn.GuiTest"
        xmlns:valueConverters="clr-namespace:Craft.UI.Utils.ValueConverters;assembly=Craft.UI.Utils"
        xmlns:reborn="clr-namespace:Craft.UIElements.Geometry2D.Reborn;assembly=Craft.UIElements"
        mc:Ignorable="d"
        Title="Craft.UIElements.Reborn.GuiTest" Height="600" Width="900"
        Loaded="MainWindow_OnLoaded" d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <valueConverters:EnumMatchToBooleanConverter x:Key="EnumMatchToBooleanConverter"/>
        <Style x:Key="CanvasModeButtonStyle" TargetType="RadioButton"
               BasedOn="{StaticResource {x:Static ToolBar.ToggleButtonStyleKey}}">
            <Setter Property="GroupName" Value="CanvasMode"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto" MaxWidth="200"/>
        </Grid.ColumnDefinitions>

        <Menu Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <MenuItem Header="Save" Command="{Binding SaveGeometryCommand}"/>
            <MenuItem Header="Load" Command="{Binding LoadGeometryCommand}"/>
        </Menu>

        <ToolBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <RadioButton Content="Select" Style="{StaticResource CanvasModeButtonStyle}"
                    IsChecked="{Binding GeometryViewModel.CanvasMode, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Select}"
                    Command="{Binding ChangeCanvasModeCommand}"
                    CommandParameter="Select"/>
            <RadioButton Content="Draw" Style="{StaticResource CanvasModeButtonStyle}"
                    IsChecked="{Binding GeometryViewModel.CanvasMode, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Draw}"
                    Command="{Binding ChangeCanvasModeCommand}"
                    CommandParameter="Draw"/>
            <RadioButton Content="Dot" Style="{StaticResource CanvasModeButtonStyle}"
                    IsChecked="{Binding GeometryViewModel.CanvasMode, Mode=OneWay, Converter={StaticResource EnumMatchToBooleanConverter}, ConverterParameter=Dot}"
                    Command="{Binding ChangeCanvasModeCommand}"
                    CommandParameter="Dot"/>
            <Separator/>
            <Label Content="_Label:" Target="{Binding ElementName=DrawingLabelInput}"/>
            <TextBox x:Name="DrawingLabelInput" Width="180"
                     Text="{Binding DrawingLabel, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Combined with Number to label new points, arrows, and completed polylines. Leave both fields blank for unlabeled geometry."/>
            <Label Content="_Number:" Target="{Binding ElementName=DrawingLabelNumberInput}"/>
            <TextBox x:Name="DrawingLabelNumberInput" Width="70"
                     Text="{Binding DrawingLabelNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                     PreviewTextInput="DrawingLabelNumber_PreviewTextInput"
                     PreviewKeyDown="DrawingLabelNumber_PreviewKeyDown"
                     DataObject.Pasting="DrawingLabelNumber_Pasting"
                     ToolTip="Optional non-negative integer. Increments after each completed point, arrow, or polyline."/>
        </ToolBar>

        <Border Grid.Row="2" Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="3">
            <reborn:GeometryView DataContext="{Binding}"
                                 FrameHandler="{Binding}"/>
        </Border>

        <Grid Grid.Row="2" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="75"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Margin="0, 0, 10, 0"/>
            <TextBlock Grid.Row="0" Grid.Column="1" ToolTip="{Binding GeometryViewModel.CoordinateReadoutDescription}" Text="{Binding GeometryViewModel.PlacementWorldPosition.X, StringFormat=0.#####}"/>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" Margin="0, 0, 10, 0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" ToolTip="{Binding GeometryViewModel.CoordinateReadoutDescription}" Text="{Binding GeometryViewModel.PlacementWorldPosition.Y, StringFormat=0.#####}"/>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="X scaling:" Margin="0, 0, 10, 0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeometryViewModel.ViewState.Scaling.Width, StringFormat=N5}"/>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Y scaling:" Margin="0, 0, 10, 0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeometryViewModel.ViewState.Scaling.Height, StringFormat=N5}"/>
            <GroupBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="DarkSlateGray" BorderThickness="1" Header="World Window">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindow.MinX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindow.MinY, StringFormat=N5}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="X max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindow.MaxX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Y max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindow.MaxY, StringFormat=N5}"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="DarkSlateGray" BorderThickness="1" Header="Expanded World Window">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowExpanded.MinX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowExpanded.MinY, StringFormat=N5}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="X max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowExpanded.MaxX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Y max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowExpanded.MaxY, StringFormat=N5}"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                      BorderBrush="DarkSlateGray" BorderThickness="1"
                      Header="World Window Bounds">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowBounds.MinX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Y min:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowBounds.MinY, StringFormat=N5}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="X max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowBounds.MaxX, StringFormat=N5}"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Y max:" Margin="0, 0, 10, 0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding GeometryViewModel.WorldWindowBounds.MaxY, StringFormat=N5}"/>
                </Grid>
            </GroupBox>
        </Grid>

        <Grid Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5, 0, 0, 5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" BorderBrush="DarkSlateGray" BorderThickness="1"
                          Header="Set World Window Bounds">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X min:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWWBounds_XMin}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y min:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWWBounds_YMin}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="X max:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWWBounds_XMax}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Y max:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWWBounds_YMax}"/>
                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" Content="Apply"
                                Width="40" Margin="3, 0, 0, 0"
                                Command="{Binding SetWorldWindowBoundsCommand}"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="1" BorderBrush="DarkSlateGray" BorderThickness="1"
                          Header="Set World Window">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X min:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWW_XMin}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y min:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWW_YMin}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="X max:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWW_XMax}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Y max:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="1"
                                 Text="{Binding RequestedWW_YMax}"/>
                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="4" Content="Apply"
                                Width="40" Margin="3, 0, 0, 0"
                                Command="{Binding SetWorldWindowCommand}"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0"
                          BorderBrush="DarkSlateGray" BorderThickness="1"
                          Header="Set World Focus">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_FocusX}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Y:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_FocusY}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="X ratio:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_FocusRatioX}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Y ratio:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_FocusRatioY}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="X scaling:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_ScalingX}"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Y scaling:" Margin="0, 0, 10, 0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Margin="1"
                         Text="{Binding RequestedWW_ScalingY}"/>
                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="6" Content="Apply"
                        Width="40" Margin="3, 0, 0, 0"
                        Command="{Binding SetWorldFocusCommand}"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="1" BorderBrush="DarkSlateGray" BorderThickness="1"
                          Header="Set Time Interval (x)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Date min:" Margin="0, 0, 10, 0"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" Margin="0, 0, 0, 2"
                                    SelectedDate="{Binding RequestedStartDate}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Date max:" Margin="0, 0, 10, 0"/>
                        <DatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding RequestedEndDate}"/>
                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Content="Apply"
                                Width="40" Margin="3, 0, 0, 0"
                                Command="{Binding SetTimeIntervalCommand}"/>
                    </Grid>
                </GroupBox>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="Focus Shift"
                          BorderBrush="DarkSlateGray" BorderThickness="1">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Content="Damp" IsChecked="{Binding GeometryViewModel.DampFocusShifts}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Damping:" Margin="0, 0, 10, 0"/>
                            <TextBox Grid.Column="1" Text="{Binding FocusShiftDamping}" Width="30" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Grid.Row="1" Header="Drawing"
                          BorderBrush="DarkSlateGray" BorderThickness="1">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Content="Snap placement" IsChecked="{Binding GeometryViewModel.SnapToGrid}"
                                  ToolTip="Snap new positions to multiples of the spacing, even when the grid is hidden."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Spacing:" Margin="0, 0, 8, 0" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" MinWidth="80"
                                      ItemsSource="{Binding SnapSpacingPresets}"
                                      Text="{Binding GridSpacing, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ToolTip" Value="World units: 1 gives integers, 0.1 gives tenths. Choose a preset or type a positive value using a decimal point."/>
                                        <Style.Triggers>
                                            <Trigger Property="Validation.HasError" Value="True">
                                                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="World units · grid can stay hidden" FontSize="10" Margin="0,3,0,0"/>
                    </StackPanel>
                </GroupBox>
            </Grid>
            <GroupBox Grid.Column="3" Header="Geometry View Control Params"
                      BorderBrush="DarkSlateGray" BorderThickness="1">
                <StackPanel Margin="3">
                    <CheckBox Content="Lock aspect ratio" IsChecked="{Binding GeometryViewModel.LockAspectRatio}"/>
                    <CheckBox Content="Lock X axis" IsChecked="{Binding GeometryViewModel.LockXAxis}"/>
                    <CheckBox Content="Lock Y axis" IsChecked="{Binding GeometryViewModel.LockYAxis}"/>
                    <CheckBox Content="Show grid" IsChecked="{Binding GeometryViewModel.ShowGrid}"/>
                    <CheckBox Content="Show coordinate system" IsChecked="{Binding GeometryViewModel.ShowCoordinateSystem}"/>
                    <CheckBox Content="Time axis mode (x)" IsChecked="{Binding GeometryViewModel.TimeAxisMode}"/>
                    <CheckBox Content="Debug mode" IsChecked="{Binding GeometryViewModel.DebugMode}"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="4" Header="Host Params"
                      BorderBrush="DarkSlateGray" BorderThickness="1">
                <StackPanel Margin="3">
                    <CheckBox Content="Continually Move Focus" IsChecked="{Binding ContinuallyMoveFocus}"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
